# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Paddle dashboard → Developer Tools → Authentication → API keys (secret key,
# not the client-side token in lib/paddle.ts).
PADDLE_API_KEY=

# Paddle dashboard → Developer Tools → Notifications → your webhook
# destination → signing secret. Sandbox and production each have their own.
PADDLE_WEBHOOK_SECRET=

# Upstash Redis (console.upstash.com) → create a database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (resend.com/api-keys). RESEND_FROM_EMAIL must be on a domain you've
# verified in Resend — leave unset to send from their shared test address
# while developing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Used to build the download link sent in the delivery email.
SITE_URL=https://montsounds.com
